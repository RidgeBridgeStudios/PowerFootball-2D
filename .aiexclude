# Google AI Studio / Gemini Indexing & Token Waste Ignore Rules
# Prevents context pollution and token waste on binary assets, engine caches, and generated artifacts.

# Godot engine caches and export presets
.godot/
export_presets.cfg
build/
bin/
dist/
.gut_editor_config.json
addons/gut/

# Godot import files and auto-generated UID caches
*.import
*.uid
*.ctex
*.md5
*.cache
*.bin

# Python runtime and bytecode caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary build, logs, editor, and OS artifacts
art/**/*.import
art/**/*.tmp
*.tmp
*.bak
*.log
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Historical archive files
docs/archive/
